# =========================================================
# LOJAS NEON  |  regras do servidor (Apache, hospedagem UOL)
#
# 1. Tudo em https
# 2. Endereco limpo: /produtos em vez de /produtos.html
# 3. Cache longo para imagens, css e js (eles ja levam ?v=NN na chamada)
# 4. Compressao de texto
#
# Detalhe desta hospedagem: o certificado e resolvido por um proxy na frente do
# Apache. Por isso %{HTTPS} chega sempre como "off" e a porta sempre como 80,
# mesmo numa visita segura. Quem sabe a verdade e o cabecalho X-Forwarded-Proto,
# descoberto com uma sonda em 17/09/2026.
# =========================================================

DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. visita que chegou por http vai para https.
  #    Precisa vir antes das outras: a regra do endereco limpo termina em [L]
  #    e o processamento pararia ali.
  #    O endereco e remontado a partir do pedido original (THE_REQUEST) porque
  #    o servidor ja resolve /produtos para produtos.html antes do rewrite, e
  #    sem isso a visita daria dois saltos ate chegar no endereco limpo.
  RewriteCond %{HTTP:X-Forwarded-Proto} =http
  RewriteCond %{THE_REQUEST} \s/+([^?\s]*)
  RewriteRule ^ https://%{HTTP_HOST}/%1 [R=301,L]

  # 2. /produtos.html manda para /produtos, para o Google nao ver duas paginas iguais
  RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html[\s?] [NC]
  RewriteRule ^ https://%{HTTP_HOST}/%1 [R=301,L]

  # 3. e /produtos serve o arquivo produtos.html
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/x-icon            "access plus 1 year"
  ExpiresByType text/css                "access plus 1 month"
  ExpiresByType application/javascript  "access plus 1 month"
  ExpiresByType text/html               "access plus 10 minutes"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json image/svg+xml
</IfModule>
